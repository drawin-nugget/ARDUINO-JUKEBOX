void setup()
{
    pinMode(backButton, INPUT_PULLUP);
    pinMode(pauseButton, INPUT_PULLUP);
    pinMode(nextButton, INPUT_PULLUP);

    pinMode(buzzer, OUTPUT);

    lcd.begin(16, 2);
    lcd.clear();
    lcd.setCursor(0,0);
}

void changeSong(int newSong)
{
    currentSong = newSong;

   if (currentSong < 0)
    currentSong = SONG_COUNT - 1;

if (currentSong >= SONG_COUNT)
    currentSong = 0;

    noteIndex = 0;
    notePlaying = false;

    noTone(buzzer);
}

void playCurrentSong(const int *melody, int notes)
{
    if (paused)
        return;

    if (!notePlaying)
    {
        if (noteIndex >= notes * 2)
        {
            noteIndex = 0;
            return;
        }

        int note =
    	pgm_read_word_near(melody + noteIndex);

		int divider =
    	pgm_read_word_near(melody + noteIndex + 1);
	
      	int wholenote =
        (60000 * 4) / songTempos[currentSong];

        if (divider > 0)
        {
            noteDuration = wholenote / divider;
        }
        else
        {
            noteDuration = wholenote / abs(divider);
            noteDuration = noteDuration * 3 / 2;
        }

        if (note != REST)
        {
         tone(buzzer, note);
        }

        noteStartTime = millis();
        notePlaying = true;
    }

    if (millis() - noteStartTime >= noteDuration)
    {
        noTone(buzzer);

        noteIndex += 2;
        notePlaying = false;
    }
}
   


